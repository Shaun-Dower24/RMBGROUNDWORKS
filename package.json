{
  "name": "rmb-groundworks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "node ./dist/server/entry.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests astro.config.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.1",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=9.6.5"
  }
}
