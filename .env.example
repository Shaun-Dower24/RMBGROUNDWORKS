# Server-side mail configuration. Never commit a real .env file.
# Use an existing approved SMTP account and an authenticated sender domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Plain email addresses only. No visitor-controlled From or recipient.
SMTP_FROM=
ENQUIRY_TO=

# Build-time opt-in only after production content/domain checks are complete.
SITE_INDEXABLE=false

# Optional exact preview hostname (without scheme). Rebuild after setting.
PREVIEW_HOST=
