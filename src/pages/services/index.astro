---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import ContactBand from '../../components/ContactBand.astro';
import { services } from '../../data/site';
---

<Base
  title="Groundworks & Civil Engineering Services"
  description="Explore RMB's foundations, basement civil works, drainage, demolition, car parks and external works across Hertfordshire, London and the Home Counties."
>
  <section class="page-heading container">
    <p class="eyebrow">Our services</p>
    <h1>
      The foundations.
      <br />
      The details. The finish.
    </h1>
    <div class="page-heading__bottom">
      <p>
        Groundworks and civil engineering from the first site works to the external finishes. Find
        the right starting point for your project.
      </p>
      <a class="text-link" href="/contact/">
        Discuss your scope <Icon />
      </a>
    </div>
  </section>
  <section class="section section--mist">
    <div class="container service-index-list">
      {services.map((service, i) => (
        <article class="service-index-card" data-reveal>
          <a
            class="service-index-card__image"
            href={`/services/${service.slug}/`}
            aria-label={`Explore ${service.title}`}
          >
            <Media src={`services/${service.image}`} alt={service.imageAlt} />
          </a>
          <div>
            <p class="eyebrow">0{i + 1} / Our capabilities</p>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
            <a class="text-link" href={`/services/${service.slug}/`}>
              Explore this service <Icon />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <ContactBand title="Tell us what you’re planning." />
</Base>
