---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contacts, services } from '../data/site';
---

<Base
  title="Discuss Your Project"
  description="Discuss a groundworks project or tender with RMB Groundworks. Call 07864 692868 or send your scope, site location and project details."
>
  <section class="page-heading container">
    <p class="eyebrow">Let's talk</p>
    <h1>
      Your project.
      <br />
      Our next conversation.
    </h1>
    <div class="page-heading__bottom">
      <p>
        Have a project in mind or a tender to discuss? Tell us about the site and the scope, and we
        can work through the next steps.
      </p>
    </div>
  </section>
  <section id="quote" class="section container contact-layout">
    <div class="contact-details">
      <h2>Start with a conversation.</h2>
      <a class="text-link" href={contacts.phoneHref}>
        {contacts.phone}
        <Icon />
      </a>
      <a class="contact-email" href={contacts.emailHref}>
        {contacts.email}
      </a>
      <div class="contact-detail">
        <p class="eyebrow">Our base</p>
        <p>
          {contacts.addressLines.map((line) => (
            <Fragment>
              {line}
              <br />
            </Fragment>
          ))}
        </p>
      </div>
      <div class="contact-detail">
        <p class="eyebrow">Where we work</p>
        <p>{contacts.coverage}. Share your site location so we can discuss the project.</p>
      </div>
      <div class="contact-detail">
        <p class="eyebrow">When to call</p>
        <p>{contacts.hours}</p>
      </div>
      <div class="contact-detail">
        <p class="eyebrow">Tender enquiries</p>
        <p>
          Include the scope, site location and submission deadline. You can send drawing links or
          arrange to share documents by email.
        </p>
      </div>
    </div>
    <div class="contact-form">
      <h2>Tell us what you’re planning.</h2>
      <p>
        A few details will help us understand the work. Please provide an email address or a phone
        number.
      </p>
      <noscript>
        <div class="form-noscript">
          Please <a href={contacts.emailHref}>email your project details</a> or{' '}
          <a href={contacts.phoneHref}>call {contacts.phone}</a> to discuss the work.
        </div>
        <style>
          form[data-enquiry-form] {
            display: none;
          }
        </style>
      </noscript>
      <form action="/api/enquiry" method="post" data-enquiry-form>
        <div class="honeypot" aria-hidden="true">
          <label>
            Leave this field empty
            <input type="text" name="website" tabindex="-1" autocomplete="off" maxlength="200" />
          </label>
        </div>
        <div class="form-grid">
          <div class="field">
            <label for="name">Your name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              maxlength="100"
              aria-describedby="error-name"
            />
            <span class="field-error" id="error-name" data-field-error="name"></span>
          </div>
          <div class="field">
            <label for="company">
              Company <span class="optional">optional</span>
            </label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              maxlength="160"
              aria-describedby="error-company"
            />
            <span class="field-error" id="error-company" data-field-error="company"></span>
          </div>
          <div class="field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              aria-describedby="error-email"
            />
            <span class="field-error" id="error-email" data-field-error="email"></span>
          </div>
          <div class="field">
            <label for="phone">Phone number</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              maxlength="40"
              aria-describedby="error-phone"
            />
            <span class="field-error" id="error-phone" data-field-error="phone"></span>
          </div>
          <div class="field">
            <label for="intent">Enquiry type</label>
            <select id="intent" name="intent" aria-describedby="error-intent">
              <option value="project">Project enquiry</option>
              <option value="tender">Tender enquiry</option>
            </select>
            <span class="field-error" id="error-intent" data-field-error="intent"></span>
          </div>
          <div class="field">
            <label for="location">Site location / postcode</label>
            <input
              id="location"
              name="location"
              type="text"
              required
              maxlength="160"
              aria-describedby="error-location"
            />
            <span class="field-error" id="error-location" data-field-error="location"></span>
          </div>
          <div class="field">
            <label for="service">
              Service <span class="optional">optional</span>
            </label>
            <select id="service" name="service" aria-describedby="error-service">
              <option value="">Select a service</option>
              {services.map((service) => (
                <option value={service.slug}>{service.shortTitle}</option>
              ))}
              <option value="multiple">Multiple services / not sure</option>
            </select>
            <span class="field-error" id="error-service" data-field-error="service"></span>
          </div>
          <div class="field">
            <label for="timeframe">
              Target date / tender deadline <span class="optional">optional</span>
            </label>
            <input
              id="timeframe"
              name="timeframe"
              type="text"
              maxlength="120"
              placeholder="For example, spring 2027"
              aria-describedby="error-timeframe"
            />
            <span class="field-error" id="error-timeframe" data-field-error="timeframe"></span>
          </div>
          <div class="field field--wide">
            <label for="message">A little about the work</label>
            <textarea
              id="message"
              name="message"
              required
              maxlength="5000"
              rows="5"
              placeholder="Your scope, the stage of the project and any useful drawing links…"
              aria-describedby="error-message"
            ></textarea>
            <span class="field-error" id="error-message" data-field-error="message"></span>
          </div>
        </div>
        <p class="form-footnote">
          We use these details to respond to your enquiry. Read our{' '}
          <a href="/privacy/">privacy information</a>. Fields marked optional can be left blank.
        </p>
        <div class="form-feedback" role="alert" hidden data-form-feedback tabindex="-1"></div>
        <button class="button" type="submit">
          <span data-submit-label>Send your enquiry</span>
          <Icon />
        </button>
      </form>
      <div class="form-success" hidden data-form-success role="status" tabindex="-1">
        <Icon name="check" />
        <h3>Thank you for getting in touch.</h3>
        <p>
          Your enquiry has been accepted for sending to the RMB team. If your project is
          time-sensitive, please call {contacts.phone} during our working hours.
        </p>
      </div>
    </div>
  </section>
</Base>
